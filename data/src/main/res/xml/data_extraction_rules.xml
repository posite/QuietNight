<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 녹음 파일과 절대 경로가 포함된 DB를 함께 제외한다. -->
        <exclude domain="file" path="snore_clips/" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="snore_clips/" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
