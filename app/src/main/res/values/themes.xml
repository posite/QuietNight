<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Compose 가 그려지기 전 초기 윈도우 배경. windowBackground 를 DayNight 색상(@color/window_background,
         values-night 로 자동 전환)으로 지정해 다크 모드 콜드 스타트 시 흰 화면 번쩍임을 없앤다. -->
    <style name="Theme.QuietNight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
